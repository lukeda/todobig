{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todobig",
  "version": "0.1.0",
  "identifier": "com.luke.todobig",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:7010",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "todobig",
        "label": "main",
        "width": 400,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}